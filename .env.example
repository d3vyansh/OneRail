PORT=3000
# Used when running outside Docker (npm run dev / npm start). Under
# docker-compose, this is overridden automatically to point at the mongo
# service — see docker-compose.yml.
mongoURL=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
xrapid_apikey=your_rapidapi_key
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=your_preferred_region
SES_FROM_EMAIL=your_verified_ses_sender_email
ALLOWED_ORIGINS=http://localhost:5173
# Optional. Defaults to 'info' (or 'silent' automatically during tests).
# One of: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
# Optional. Enables the Redis response cache for train/fare lookups. Leave
# unset to disable caching (the API works the same, it just calls the
# upstream every time). Under docker-compose this is set automatically.
# Hosted example (Upstash, TLS): rediss://default:<password>@<host>:6379
REDIS_URL=
